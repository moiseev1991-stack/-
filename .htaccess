# Apache config for static Next.js export with Arabic URL paths.

AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ──────────────────────────────────────────────────────────────────────
  # Host canonicalization: force https + non-www on the punycode domain.
  # ──────────────────────────────────────────────────────────────────────
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ──────────────────────────────────────────────────────────────────────
  # 301 EN-slug duplicates → Arabic canonical URLs (percent-encoded).
  # Keeps the underlying ASCII directories in out/ intact (Apache serves
  # them via Arabic aliases produced by scripts/add-arabic-aliases.mjs),
  # while the public-facing EN URLs become permanent redirects.
  # ──────────────────────────────────────────────────────────────────────

  # Explicit duplicate paths called out in the SEO TZ
  RewriteRule ^casino-games/?$ /%D8%A7%D9%84%D8%B9%D8%A7%D8%A8-%D9%83%D8%A7%D8%B2%D9%8A%D9%86%D9%88/ [R=301,L,NE]
  RewriteRule ^new-casinos/?$ /%D9%83%D8%A7%D8%B2%D9%8A%D9%86%D9%88-%D8%AC%D8%AF%D9%8A%D8%AF/ [R=301,L,NE]
  RewriteRule ^payment/fast-withdrawal/?$ /%D8%A7%D8%B3%D8%B1%D8%B9-%D8%B3%D8%AD%D8%A8/ [R=301,L,NE]
  RewriteRule ^payment/fastest-withdrawals/?$ /%D8%A7%D8%B3%D8%B1%D8%B9-%D8%B3%D8%AD%D8%A8/ [R=301,L,NE]

  # The wider EN→AR canonical map (every ASCII slug that has an Arabic alias)
  RewriteRule ^payment/?$ /%D8%B7%D8%B1%D9%82-%D8%A7%D9%84%D8%AF%D9%81%D8%B9/ [R=301,L,NE]
  RewriteRule ^games/?$ /%D8%A7%D9%84%D8%B9%D8%A7%D8%A8-%D9%83%D8%A7%D8%B2%D9%8A%D9%86%D9%88/ [R=301,L,NE]
  RewriteRule ^new/?$ /%D9%83%D8%A7%D8%B2%D9%8A%D9%86%D9%88-%D8%AC%D8%AF%D9%8A%D8%AF/ [R=301,L,NE]
  RewriteRule ^real-money/?$ /%D9%83%D8%A7%D8%B2%D9%8A%D9%86%D9%88-%D8%AD%D9%82%D9%8A%D9%82%D9%8A/ [R=301,L,NE]
  RewriteRule ^slots/mobile/?$ /%D8%B3%D9%84%D9%88%D8%AA%D8%B3-%D9%85%D9%88%D8%A8%D8%A7%D9%8A%D9%84/ [R=301,L,NE]
  RewriteRule ^slots/?$ /%D8%B3%D9%84%D9%88%D8%AA%D8%B3/ [R=301,L,NE]
  RewriteRule ^roulette/?$ /%D8%B1%D9%88%D9%84%D9%8A%D8%AA/ [R=301,L,NE]
  RewriteRule ^blackjack/?$ /%D8%A8%D9%84%D8%A7%D9%83-%D8%AC%D8%A7%D9%83/ [R=301,L,NE]
  RewriteRule ^apps/?$ /%D8%AA%D8%B7%D8%A8%D9%8A%D9%82%D8%A7%D8%AA/ [R=301,L,NE]
  RewriteRule ^bonuses/?$ /%D8%A8%D9%88%D9%86%D8%B5-%D8%AA%D8%B1%D8%AD%D9%8A%D8%A8/ [R=301,L,NE]
  RewriteRule ^free-games/?$ /%D8%A7%D9%84%D8%B9%D8%A7%D8%A8-%D9%85%D8%AC%D8%A7%D9%86%D9%8A%D8%A9/ [R=301,L,NE]
  RewriteRule ^live-casino/?$ /%D9%83%D8%A7%D8%B2%D9%8A%D9%86%D9%88-%D9%85%D8%A8%D8%A7%D8%B4%D8%B1/ [R=301,L,NE]
  RewriteRule ^no-verification/?$ /%D8%A8%D8%AF%D9%88%D9%86-%D8%AA%D9%88%D8%AB%D9%8A%D9%82/ [R=301,L,NE]

  # Legal/info pages: ASCII /info/* → Arabic canonical
  RewriteRule ^info/about-us/?$ /%D9%85%D9%86-%D9%86%D8%AD%D9%86/ [R=301,L,NE]
  RewriteRule ^info/privacy-policy/?$ /%D8%B3%D9%8A%D8%A7%D8%B3%D8%A9-%D8%A7%D9%84%D8%AE%D8%B5%D9%88%D8%B5%D9%8A%D8%A9/ [R=301,L,NE]
  RewriteRule ^info/cookie-policy/?$ /%D8%B3%D9%8A%D8%A7%D8%B3%D8%A9-%D9%85%D9%84%D9%81%D8%A7%D8%AA-%D8%AA%D8%B9%D8%B1%D9%8A%D9%81-%D8%A7%D9%84%D8%A7%D8%B1%D8%AA%D8%A8%D8%A7%D8%B7/ [R=301,L,NE]
  RewriteRule ^info/terms-of-use/?$ /%D8%B4%D8%B1%D9%88%D8%B7-%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%AE%D8%AF%D8%A7%D9%85/ [R=301,L,NE]
  RewriteRule ^info/disclaimer-and-responsible-gaming/?$ /%D8%A7%D8%AE%D9%84%D8%A7%D8%A1-%D8%A7%D9%84%D9%85%D8%B3%D9%88%D9%88%D9%84%D9%8A%D8%A9-%D9%88%D8%A7%D9%84%D9%85%D9%82%D8%A7%D9%85%D8%B1%D8%A9-%D8%A7%D9%84%D9%85%D8%B3%D9%88%D9%88%D9%84%D8%A9/ [R=301,L,NE]
  RewriteRule ^info/contact-us/?$ /%D8%A7%D8%AA%D8%B5%D9%84-%D8%A8%D9%86%D8%A7/ [R=301,L,NE]
  RewriteRule ^info/how-we-rate-casinos/?$ /%D9%83%D9%8A%D9%81-%D9%86%D9%82%D9%8A%D9%85-%D8%A7%D9%84%D9%83%D8%A7%D8%B2%D9%8A%D9%86%D9%88%D9%87%D8%A7%D8%AA/ [R=301,L,NE]

  # Legacy /legal/* aliases → same Arabic canonicals
  RewriteRule ^legal/about-us/?$ /%D9%85%D9%86-%D9%86%D8%AD%D9%86/ [R=301,L,NE]
  RewriteRule ^legal/privacy-policy/?$ /%D8%B3%D9%8A%D8%A7%D8%B3%D8%A9-%D8%A7%D9%84%D8%AE%D8%B5%D9%88%D8%B5%D9%8A%D8%A9/ [R=301,L,NE]
  RewriteRule ^legal/cookie-policy/?$ /%D8%B3%D9%8A%D8%A7%D8%B3%D8%A9-%D9%85%D9%84%D9%81%D8%A7%D8%AA-%D8%AA%D8%B9%D8%B1%D9%8A%D9%81-%D8%A7%D9%84%D8%A7%D8%B1%D8%AA%D8%A8%D8%A7%D8%B7/ [R=301,L,NE]
  RewriteRule ^legal/terms-of-use/?$ /%D8%B4%D8%B1%D9%88%D8%B7-%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%AE%D8%AF%D8%A7%D9%85/ [R=301,L,NE]
  RewriteRule ^legal/disclaimer-and-responsible-gaming/?$ /%D8%A7%D8%AE%D9%84%D8%A7%D8%A1-%D8%A7%D9%84%D9%85%D8%B3%D9%88%D9%88%D9%84%D9%8A%D8%A9-%D9%88%D8%A7%D9%84%D9%85%D9%82%D8%A7%D9%85%D8%B1%D8%A9-%D8%A7%D9%84%D9%85%D8%B3%D9%88%D9%88%D9%84%D8%A9/ [R=301,L,NE]
  RewriteRule ^legal/contact-us/?$ /%D8%A7%D8%AA%D8%B5%D9%84-%D8%A8%D9%86%D8%A7/ [R=301,L,NE]
  RewriteRule ^legal/how-we-rate-casinos/?$ /%D9%83%D9%8A%D9%81-%D9%86%D9%82%D9%8A%D9%85-%D8%A7%D9%84%D9%83%D8%A7%D8%B2%D9%8A%D9%86%D9%88%D9%87%D8%A7%D8%AA/ [R=301,L,NE]

  # /reviews/<slug>/ → /مراجعات/<slug>/ (Arabic public URL is canonical)
  RewriteRule ^reviews/(.+)$ /%D9%85%D8%B1%D8%A7%D8%AC%D8%B9%D8%A7%D8%AA/$1 [R=301,L,NE]

  # ──────────────────────────────────────────────────────────────────────
  # Static export fallback: serve .html for extension-less requests.
  # ──────────────────────────────────────────────────────────────────────
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
